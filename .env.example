# Example settings for ragsearch. Placeholders only: never commit a real key.
# ragsearch reads these from the process environment (it does not load .env files itself).
# Set them in your shell, e.g. PowerShell:  $env:TAVILY_API_KEY = "tvly-..."
#                              bash/zsh:    export TAVILY_API_KEY="tvly-..."

# Local Ollama server and models (small models suit 8GB RAM / 6GB VRAM)
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=nomic-embed-text
GEN_MODEL=llama3.2:3b

# ollama (real semantic embeddings) or hash (offline, for testing only)
EMBEDDER=ollama

# Where the index, manifest and Tavily usage counter are stored
DATA_DIR=data

# numpy or faiss
INDEX_BACKEND=numpy

# Optional: Tavily free plan (1,000 credits/month). Leave empty to stay fully offline.
TAVILY_API_KEY=tvly-your-key-here
# Local safety cap on credits per calendar month
TAVILY_MONTHLY_CAP=800
# search --web / ask with web=true only call Tavily when the best local score is below this
WEB_FALLBACK_THRESHOLD=0.5
